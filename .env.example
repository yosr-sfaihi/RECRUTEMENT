# ─────────────────────────────────────────────
# Yosr Sfaihi – Recruiter Landing Page
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Gmail SMTP credentials
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com > Security > App passwords
# 3. Generate an App Password for "Mail" / "Windows Computer" (or any label)
GMAIL_USER=yosrsfaihi@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Your deployed URL (used by the QR generator)
# Local dev: http://localhost:3000
# After Vercel deploy: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Attach CV PDF to every outgoing email (true | false)
ATTACH_CV=true

# Append each submission to logs/submissions.csv (true | false)
LOG_SUBMISSIONS=true

# CORS allowed origin (set to your deployed domain in production)
# e.g. https://yosr-sfaihi.vercel.app
# Leave blank to allow all origins in development
ALLOWED_ORIGIN=

# Rate limiting: max requests per window per IP
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
